import os
import streamlit as st
import docx
from pypdf import PdfReader
from google import genai

# Page configuration
st.set_page_config(page_title="ATS Resume Reviewer", page_icon="📄", layout="wide")

st.title("📄 ATS Resume Reviewer & Evaluator")
st.write("Upload your resume, paste the target job description, and get instant ATS feedback.")

# Retrieve API key from Streamlit secrets or sidebar input
api_key = st.sidebar.text_input("Enter your Gemini API Key:", type="password")
if not api_key:
    if "GEMINI_API_KEY" in st.secrets:
        api_key = st.secrets["GEMINI_API_KEY"]
    else:
        st.info(" Please enter your Gemini API key in the sidebar or configure `.streamlit/secrets.toml` to proceed.")

# Functions to extract text from PDF and DOCX
def extract_text_from_pdf(uploaded_file):
    reader = PdfReader(uploaded_file)
    text = ""
    for page in reader.pages:
        extracted = page.extract_text()
        if extracted:
            text += extracted + "\n"
    return text

def extract_text_from_docx(uploaded_file):
    doc = docx.Document(uploaded_file)
    return "\n".join([paragraph.text for paragraph in doc.paragraphs])

# UI Layout
col1, col2 = st.columns([1, 1])

with col1:
    job_description = st.text_area("Paste Job Description (Optional but Recommended):", height=200)

with col2:
    uploaded_file = st.file_uploader("Upload Resume (PDF or DOCX):", type=["pdf", "docx"])

if uploaded_file is not None:
    st.success(f"Uploaded: {uploaded_file.name}")

analyze_button = st.button("Analyze Resume")

if analyze_button:
    if not api_key:
        st.error("Please provide a valid Gemini API Key to analyze the resume.")
    elif uploaded_file is None:
        st.warning("Please upload a resume file first.")
    else:
        with st.spinner("Analyzing resume using Gemini Flash..."):
            try:
                # Determine file type and extract text
                file_extension = uploaded_file.name.split(".")[-1].lower()
                if file_extension == "pdf":
                    resume_text = extract_text_from_pdf(uploaded_file)
                elif file_extension == "docx":
                    resume_text = extract_text_from_docx(uploaded_file)
                else:
                    resume_text = ""

                if not resume_text.strip():
                    st.error("Could not extract text from the uploaded file. Please ensure it contains readable text.")
                else:
                    # Initialize Gemini Client
                    client = genai.Client(api_key=api_key)

                    prompt = f"""
                    You are an expert Applicant Tracking System (ATS) and Senior HR Technical Recruiter.
                    Analyze the following resume against the provided job description (if available).

                    ### Job Description:
                    {job_description if job_description.strip() else "Not provided (Provide a general evaluation)."}

                    ### Resume Content:
                    {resume_text}

                    ---
                    Please provide a clear and structured report with the following sections:
                    1. **ATS Match Score**: Give an overall estimated score out of 100%.
                    2. **Executive Summary**: A brief overview of how well the resume matches or stands out.
                    3. **Strengths**: Key highlights and strong qualifications found.
                    4. **Missing Keywords & Skills**: Critical technical/soft skills or keywords missing or underrepresented.
                    5. **Actionable Suggestions for Improvement**: Specific recommendations to increase the ATS score and readability.
                    """

                    response = client.models.generate_content(
                        model="gemini-2.5-flash",
                        contents=prompt,
                    )

                    st.markdown("### Analysis Results")
                    st.markdown(response.text)

            except Exception as e:
                st.error(f"An error occurred during analysis: {e}")